meta {
  name: 10. Login (Cliente)
  type: http
  seq: 10
}

post {
  url: http://localhost:5189/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "cliente",
    "password": "cliente123"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar("jwt_token", res.body.token);
  }
}
