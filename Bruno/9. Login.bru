meta {
  name: 9. Login
  type: http
  seq: 9
}

post {
  url: http://localhost:5000/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "admin",
    "password": "admin123"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar("jwt_token", res.body.token);
  }
}
